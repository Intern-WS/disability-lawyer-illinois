---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Page Not Found | DisabilityLawyerIllinois" description="The page could not be found.">
  <div class="section section-narrow"><p class="eyebrow">Error 404</p><h1>We could not find that page</h1><p>The link may be old or the address may be typed incorrectly.</p><p><a class="button" href={base}>Go to the home page</a></p></div>
</BaseLayout>
