---
const base = import.meta.env.BASE_URL;
const link = (path: string) => `${base}${path}`.replace(/\/+/g, "/");
---
<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <p class="footer-brand">DisabilityLawyerIllinois</p>
      <p>A website of <strong>Williams &amp; Swee, Ltd.</strong></p>
      <p>This demo is for review. It is not legal advice.</p>
    </div>
    <div>
      <h2>Get help</h2>
      <ul>
        <li><a href={link("ssi/")}>Learn about SSI</a></li>
        <li><a href={link("ssdi/")}>Learn about SSDI</a></li>
        <li><a href={link("disability-appeals/")}>My claim was denied</a></li>
        <li><a href={link("contact/")}>Contact the firm</a></li>
      </ul>
    </div>
    <div>
      <h2>Site information</h2>
      <ul>
        <li><a href={link("accessibility/")}>Accessibility</a></li>
        <li><a href={link("privacy/")}>Privacy</a></li>
        <li><a href={link("legal-disclaimer/")}>Legal disclaimer</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} Williams &amp; Swee, Ltd. All rights reserved.</p>
    <p><a href="https://williamsswee.com/">Visit the main Williams &amp; Swee website</a></p>
  </div>
</footer>
